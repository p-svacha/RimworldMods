			<displayName>Harmony</displayName>
			<steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
			<downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
		</li>
        <li>
			<packageId>woolstrand.realruins</packageId>
			<displayName>Real Ruins</displayName>
			<steamWorkshopUrl>steam://url/CommunityFilePage/1552146295</steamWorkshopUrl>
			<downloadUrl>https://github.com/woolstrand/RealRuins/releases/latest</downloadUrl>
		</li>
	</modDependencies>
    <loadAfter>
        <li>brrainz.harmony</li>
        <li>ludeon.rimworld</li>
        <li>woolstrand.realruins</li>
    </loadAfter> 
</ModMetaData>